# Copy to .env and fill in. `.env` is gitignored; pakka loads it at startup (no dotenv dependency).

# 1. Modal — deploys pakka's own app and gives the public URL (`modal setup` on a laptop, or a token from
#    modal.com -> Settings -> API tokens). The *model* endpoint for the Pydantic challenge does not go here:
#    it is added to the gateway with a Modal proxy token (`modal workspace proxy-tokens create`), see 2a.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# 2. The agent's model. One provider key plus the model string Pydantic AI understands.
#    Examples: google:gemini-2.5-flash (GOOGLE_API_KEY) · anthropic:claude-sonnet-5 · groq:llama-3.3-70b-versatile
#    Through the Pydantic AI Gateway (the Pydantic challenge): gateway/openai-chat:<MODEL>, where <MODEL> is the
#    Hugging Face repo id you deployed with `modal endpoint create --name gateway --model <MODEL>`
PAKKA_MODEL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# 2a. Pydantic AI Gateway (pydantic_challenge/). Base URL is the gateway ROOT (the route is appended by the code);
#     the key is created in Logfire -> Gateway; the route is the provider name you gave Modal in the gateway ("modal").
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
PYDANTIC_AI_GATEWAY_API_KEY=
PAKKA_GATEWAY_ROUTE=modal

# 3. Logfire — the record: trace screenshot and the checked-vs-held dashboard (Logfire -> project settings -> Write tokens)
LOGFIRE_TOKEN=

# 4. The name on screen
PAKKA_NAME=pakka
