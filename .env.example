# Copy to .env and fill in. `.env` is gitignored; pakka loads it at startup (no dotenv dependency).

# 1. Modal — deploys the layer and gives the public URL (modal.com -> Settings -> API tokens, or `modal token new`)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# 2. The agent's model. One provider key plus the model string Pydantic AI understands.
#    Examples: anthropic:claude-sonnet-5 · groq:llama-3.3-70b-versatile · openrouter:anthropic/claude-sonnet-5
#    Through the Pydantic AI Gateway (the Pydantic challenge): gateway/openai:<model-on-your-modal-route>
PAKKA_MODEL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# 2a. Pydantic AI Gateway (pydantic_challenge/): the key, and the named route your Modal endpoint is added as
PYDANTIC_AI_GATEWAY_API_KEY=
PAKKA_GATEWAY_ROUTE=

# 3. Logfire — the record: trace screenshot and the checked-vs-held dashboard (logfire.pydantic.dev -> project -> write token)
LOGFIRE_TOKEN=

# 4. The name on screen
PAKKA_NAME=pakka
